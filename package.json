{
  "name": "openturbo",
  "version": "0.1.0",
  "description": "Local-first open-source AI study desktop app.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/src/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "npm run build:main && electron .",
    "build": "npm run typecheck && npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:main && node --test dist/tests/*.test.js",
    "test:e2e": "playwright test --project=browser",
    "test:e2e:electron": "playwright test --project=electron",
    "test:e2e:report": "playwright show-report",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@copilotkit/a2ui-renderer": "^1.57.1",
    "@copilotkit/react-core": "^1.57.1",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "build": {
    "appId": "dev.openturbo.desktop",
    "productName": "OpenTurbo",
    "files": [
      "dist/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.education"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education"
    }
  }
}
